                ... on DirectLinkLanding {\\n                  urlPath\\n                  role\\n                  hash\\n                  queryParams {\\n                    name\\n                    value\\n                    __typename\\n                  }\\n                  __typename\\n                }\\n                ... on LoginLanding {\\n                  stub\\n                  __typename\\n                }\\n                ... on DeeplinkLanding {\\n                  urlPath\\n                  queryParams {\\n                    name\\n                    value\\n                    __typename\\n                  }\\n                  __typename\\n                }\\n                ... on ResolvedLinkLanding {\\n                  url\\n                  __typename\\n                }\\n                ... on ScrollToAnchor {\\n                  anchor\\n                  __typename\\n                }\\n                __typename\\n              }\\n              __typename\\n            }\\n            __typename\\n          }\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    ... on ScrollToAnchor {\\n      anchor\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment StackedCardItem on MerchCarouselStackedItem {\\n  itemId\\n  title\\n  subtitle\\n  extraSubtitle\\n  countryCode\\n  price {\\n    ...Price\\n    __typename\\n  }\\n  targetLanding {\\n    ...SearchResultsLanding\\n    ...ResolvedLinkLanding\\n    ...DirectLinkLanding\\n    __typename\\n  }\\n  image {\\n    ...Image\\n    __typename\\n  }\\n  filters {\\n    ...Filter\\n    __typename\\n  }\\n  reviewScore {\\n    ...ReviewScore\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment Price on MerchCarouselItemPrice {\\n  formattedPrice\\n  __typename\\n}\\n\\nfragment SearchResultsLanding on SearchResultsLanding {\\n  destType\\n  destId\\n  checkin\\n  checkout\\n  nrAdults\\n  nrChildren\\n  child