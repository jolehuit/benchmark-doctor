n        <div class=\"lpb-15 lpl-10 lpr-10 lp-s_l-25 lp-s_r-25\">\n            \r\n<div class=\"pr lcs lmb-25 bw hbss\">\r\n    <div class=\"lc lc1 hdb-xs hfl-xs lc-xs6-12 lc-s1 lc-m6-12\">\r\n        <div class=\"pr bbs hbss x hp lp-12 lpt-8\">\r\n          <a href=\"/plus/games/word-scramble\" rel=\"noopener noreferrer\">\r\n            <amp-img src=\"/external/images/games/ws_placeholder_tile.svg?version=6.0.80\" width=\"300\" height=\"180\"\r\n                 layout=\"responsive\" alt=\"Word Scramble\">\r\n            </amp-img>\r\n          </a>\r\n        </div>\r\n    </div>\r\n    <div class=\"lp-20 hoh\">\r\n        <h3 class=\"fs24 lmb-20\">Word Scramble</h3>\r\n\r\n        <div>\r\n            <p class=\"fs18\">Challenge yourself with word games from Cambridge Dictionary.</p>\r\n            <p class=\"fs18\">Read the definition. Can you beat the clock and spell the word?</p>\r\n        </div>\r\n\r\n        <div class=\"x hax htl lmt-20\">\r\n            <a href=\"/plus/games/word-scramble\" class=\"boa hao hbtn hbtn-tab tb tc-bd lmb-5\" rel=\"noopener noreferrer\">\r\n                Play            </a>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n\r\n            \n\n        \n                            <div class=\"bw hbss x lmb-25\">\n            <a href=\"https://dictionaryblog.cambridge.org/2026/08/12/theres-life-in-the-old-dog-yet-dog-idioms-part-1/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hdb hao lc lc1 lc-xs6-12 lc-s1 lc-m6-12\">\n            <amp-img src=\"/rss/images/GettyImages-2150103145.jpg\" height=\"180\" width=\"300\" alt=\"There’s life in the old dog yet! (Dog idioms, part 1)\" layout=\"responsive\">\n                <noscript>\n                    <img src=\"/rss/images/GettyImages-2150103145.jpg\" height=\"180\" width=\"300\" alt=\"There’s life in the old dog yet! (Dog idioms, part 1)\" class=\"lc1\" />\n                </noscript>\n            </amp-img>\n        </a>\n    \n    <div class=\"hoh lp-20\">\n        <p class=\"h6 lm-0 lmb-15\">Blog</p>\n        <p class=\"fs19 hlh1_5 lmb-15\">\n            <a href=\"https://dictionaryblog.cambridge.org/2026/08/12/theres-life-in-the-old-dog-yet-dog-idioms-part-1/\" class=\"ha\" target=\"_blank\" rel=\"noopener noreferrer\">There’s life in the old dog yet! (Dog idioms, part 1)</a>\n        </p>\n        <div class=\"fs14 tc-bl lmb-20\">\n                        <time datetime=\"2026-08-12\">August 12, 2026</time>\n        </div>\n        <div>\n            <a href=\"https://dictionaryblog.cambridge.org/2026/08/12/theres-life-in-the-old-dog-yet-dog-idioms-part-1/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bh hao hbtn hbtn-tab tb\">\n                Read More            </a>\n        </div>\n    </div>\n</div>\n\n\n\n                            <div class=\"pr bw hbss x lmb-25\">\n            <span class=\"hdn hdb-xs hdn-s hdb-m boa pa p0 pl0 pb0 pr50\"></span>\n    \n    <div class=\"pr boa lp-5 lpl-10 lpr-10 lc lc1 lc-xs6-12 lc-s1 lc-m6-12\">\n                    <div class=\"pr hdib i i-facebook lp-5 lmr-10\">\n            <a class=\"pa p0\" onclick=\"sendGAEvent('share_this_entry', 'facebook')\" target=\"_blank\" rel=\"noopener\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Fdictionary.cambridge.org%2Fdictionary%2Fenglish%2Fat-leisure%23cald4-1&t=\" title=\"Share on Facebook\"></a>\n        </div>\n        <div class=\"pr hdib i i-x lp-5 lmr-10\">\n            <a class=\"pa p0\" onclick=\"sendGAEvent('share_this_entry', 'twitter')\" target=\"_blank\" rel=\"noopener\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Fdictionary.cambridge.org%2Fdictionary%2Fenglish%2Fat-leisure%23cald4-1&text=\" title=\"Share on X\"></a>\n        </div>\n    \n        <div class=\"htc hax lmt-20 lmb-25\">\n            <p class=\"fs12 tcu lmb-0\">Word of the Day</p>\n            <p class=\"fs36 lmt-5 feature-w-big wotd-hw\">\n                <a href=\"/dictionary/english/at-leisure#cald4-1\">at leisure </a>\n            </p>\n                                </div>\n    </div>\n\n    <div class=\"hoh lp-20\">\n        <p class=\"lmt-0 lmb-20\">when you have enough time and are not in a hurry, or whenever you want</p>\n\n        <a href=\"/dictionary/english/at-leisure#cald4-1\" class=\"bh hao hbtn hbtn-tab tb\">About this</a>\n    </div>\n</div>\n\n\n<div class=\"bw hbss x lmb-25\">\n                    \n                                                \n                <a href=\"https://dictionaryblog.cambridge.org/2026/07/27/new-words-27-july-2026/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hdb hao lc lc1 lc-xs6-12 lc-s1 lc-m6-12\">\n            <amp-img src=\"/rss/images/tasteslop.jpg\" height=\"180\" width=\"300\" alt=\"<p>tasteslop\" layout=\"responsive\">\n                <noscript>\n                    <img src=\"/rss/images/tasteslop.jpg\" height=\"180\" width=\"300\" alt=\"<p>tasteslop\" class=\"lc1\" />\n                </noscript>\n            </amp-img>\n        </a>\n                <div class=\"hoh lp-20\">\n        <p class=\"h6 lm-0 lmb-5\">New Words</p>\n\n        <div class=\"lmb-15  fs36 \">\n            <a href=\"https://dictionaryblog.cambridge.org/2026/07/27/new-words-27-july-2026/\" class=\"ha\" target=\"_blank\" rel=\"noopener noreferrer\"><p>tasteslop</a>\n        </div>\n\n        <div class=\"fs14 tc-bl lmb-20\">\n                        <time datetime=\"2026-07-27\">July 27, 2026</time>\n        </div>\n\n        <a href=\"https://dictionaryblog.cambridge.org/2026/07/27/new-words-27-july-2026/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bh hao hbtn hbtn-tab tb\">\n            More new words        </a>\n    </div>\n</div>\n    \n                        \n        \n    <div class=\"bpb c_ps lmb-25 lp-20 lpt-25 lp-s_l-25\">\n        <h2 class=\"lp-m_l-25\">Popular searches</h2>\n                    <div class=\"lmb-25 lp-m_l-25\">\n                English <span>Dictionary</span>\n            </div>\n                <div class