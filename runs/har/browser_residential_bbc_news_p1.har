l-styles__IconWrapper-sc-a498a926-1 ivfwKz\"><svg viewBox=\"0 0 32 32\" width=\"30\" height=\"30\" category=\"playback-avkx\" icon=\"play\" type=\"playback-avkx:play\" class=\"Icon-styles__IconStyled-sc-4d91d42a-0 iosMJz\"><path d=\"M29 16 5.8 1v30L29 16z\"></path></svg></div></div></div></div><div data-testid=\"card-text-wrapper\" class=\"Grid-styles__GridStyled-sc-772acff9-0 kYsqtw\"><div class=\"IndexCardHeading-styles__TitleGravityWrapper-sc-c7d910a6-1 dWFLGi\"><div class=\"IndexCardHeading-styles__TitleWrapperStyled-sc-c7d910a6-0 hEhfIe\"><h2 data-testid=\"card-headline\" class=\"IndexCardHeading-styles__CardHeadlineStyled-sc-c7d910a6-3 dyeGOh\">Watch: Why Tupac Shakur&#x27;s murder trial is happening 30 years after he was killed</h2></div></div><p data-testid=\"card-description\" class=\"Dundee-styles__DescriptionStyled-sc-50abbc98-0 eUixcX\">The rapper was fatally shot four times in a drive-by crime in September 1996, and only one person has ever been charged in connection to his death.</p><div class=\"IndexCardMetadata-styles__MetadataStyled-sc-10966952-0 fIfKvi\"><span data-testid=\"card-metadata-lastupdated\" class=\"IndexCardMetadata-styles__MetaDataDateStyled-sc-10966952-1 feNzEJ\">22 hrs ago</span><div data-testid=\"card-metadata-separator\" class=\"IndexCardMetadata-styles__Separator-sc-10966952-3 decXPj\"></div><span data-testid=\"card-metadata-tag\" class=\"IndexCardMetadata-styles__MetaDataTagStyled-sc-10966952-2 ewmvhB\">US &amp; Canada</span></div></div></div></a></div></div></div><div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 fNwnHZ\"><div data-testid=\"dundee-card\" data-indexcard=\"true\" class=\"IndexCard-styles__IndexCardStyled-sc-3a0d8802-0 jeApUG\"><div data-testid=\"anchor-inner-wrapper\"><a href=\"/news/articles/cq56pzqy6jvo\" data-testid=\"internal-link\" class=\"Anchor-styles__AnchorStyled-sc-651d33db-0 hygVWX\"><div data-testid=\"dundee-article\" class=\"Dundee-styles__CardStyled-sc-50abbc98-1 jHXbAb\"><div data-testid=\"card-image-wrapper\" class=\"Dundee-styles__ImageWrapperStyled-sc-50abbc98-3 ejTXUZ\"><div data-testid=\"card-media\" class=\"Dundee-styles__CardMediaStyled-sc-50abbc98-4 gZwtmn\"><div class=\"Image-styles__ImageCardStyled-sc-8c99a12b-1 erovmj\"><img src=\"https://static.files.bbci.co.uk/bbcdotcom/web/20260729-174851-148577b706-web-3.17.0-2/grey-placeholder.png\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 kpUtIW hide-when-no-script\" aria-label=\"image unavailable\"/><img sizes=\"25vw\" srcSet=\"https://ichef.bbci.co.uk/news/240/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp 240w,https://ichef.bbci.co.uk/news/320/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp 320w,https://ichef.bbci.co.uk/news/480/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp 480w,https://ichef.bbci.co.uk/news/640/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp 640w,https://ichef.bbci.co.uk/news/800/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp 800w,https://ichef.bbci.co.uk/news/1024/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp 1024w,https://ichef.bbci.co.uk/news/1536/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp 1536w\" src=\"https://ichef.bbci.co.uk/news/480/cpsprodpb/1a22/live/86235450-9731-11f1-870d-5d08c49babb2.jpg.webp\" loading=\"lazy\" alt=\"A screenshot from the game No 10: Full Confidence. It shows five silhouettes with one in the centre with their hand to their head, underneath a light and in front of a table with a red box. Two silhouettes are either side, one with a microphone, another filming them.\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 cVsHni\"/></div></div></div><div data-testid=\"card-text-wrapper\" class=\"Grid-styles__GridStyled-sc-772acff9-0 kYsqtw\"><div class=\"IndexCardHeading-styles__TitleGravityWrapper-sc-c7d910a6-1 dWFLGi\"><div class=\"IndexCardHeading-styles__TitleWrapperStyled-sc-c7d910a6-0 hEhfIe\"><h2 data-testid=\"card-headline\" class=\"IndexCardHeading-styles__CardHeadlineStyled-sc-c7d910a6-3 dyeGOh\">I survived two years as prime minister in a hit new game - then my cabinet deserted me</h2></div></div><p data-testid=\"card-description\" class=\"Dundee-styles__DescriptionStyled-sc-50abbc98-0 eUixcX\">Mobile game No 10: Full Confidence recently ranked above Minecraft on the UK App Store paid games chart</p><div class=\"IndexCardMetadata-styles__MetadataStyled-sc-10966952-0 fIfKvi\"><span data-testid=\"card-metadata-lastupdated\" class=\"IndexCardMetadata-styles__MetaDataDateStyled-sc-10966952-1 feNzEJ\">21 hrs ago</span></div></div></div></a></div></div></div><div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 cAvXZN\"><div data-testid=\"dundee-card\" data-indexcard=\"true\" class=\"IndexCard-styles__IndexCardStyled-sc-3a0d8802-0 jeApUG\"><div data-testid=\"anchor-inner-wrapper\"><a href=\"/news/articles/c626d3xqd83o\" data-testid=\"internal-link\" class=\"Anchor-styles__AnchorStyled-sc-651d33db-0 hygVWX\"><div data-testid=\"dundee-article\" class=\"Dundee-styles__CardStyled-sc-50abbc98-1 jHXbAb\"><div data-testid=\"card-image-wrapper\" class=\"Dundee-styles__ImageWrapperStyled-sc-50abbc98-3 ejTXUZ\"><div data-testid=\"card-media\" class=\"Dundee-styles__CardMediaStyled-sc-50abbc98-4 gZwtmn\"><div class=\"Image-styles__ImageCardStyled-sc-8c99a12b-1 erovmj\"><img src=\"https://static.files.bbci.co.uk/bbcdotcom/web/20260729-174851-148577b706-web-3.17.0-2/grey-placeholder.png\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 kpUtIW hide-when-no-script\" aria-label=\"image unavailable\"/><img sizes=\"25vw\" srcSet=\"https://ichef.bbci.co.uk/news/240/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp 240w,https://ichef.bbci.co.uk/news/320/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp 320w,https://ichef.bbci.co.uk/news/480/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp 480w,https://ichef.bbci.co.uk/news/640/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp 640w,https://ichef.bbci.co.uk/news/800/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp 800w,https://ichef.bbci.co.uk/news/1024/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp 1024w,https://ichef.bbci.co.uk/news/1536/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp 1536w\" src=\"https://ichef.bbci.co.uk/news/480/cpsprodpb/78d0/live/953e6ee0-877b-11f1-a7ab-8b30adf0800a.jpg.webp\" loading=\"lazy\" alt=\"Man sitting on edge of bed\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 cVsHni\"/></div></div></div><div data-testid=\"card-text-wrapper\" class=\"Grid-styles__GridStyled-sc-772acff9-0 kYsqtw\"><div class=\"IndexCardHeading-styles__TitleGravityWrapper-sc-c7d910a6-1 dWFLGi\"><div class=\"IndexCardHeading-styles__TitleWrapperStyled-sc-c7d910a6-0 hEhfIe\"><h2 data-testid=\"card-headline\" class=\"IndexCardHeading-styles__CardHeadlineStyled-sc-c7d910a6-3 dyeGOh\">What&#x27;s driving men to get penis fillers, despite the risks?</h2></div></div><p data-testid=\"card-description\" class=\"Dundee-styles__DescriptionStyled-sc-50abbc98-0 eUixcX\">Men who have had the procedure can expect 10-20% more girth for the next six to nine months - but it can go wrong.</p><div class=\"IndexCardMetadata-styles__MetadataStyled-sc-10966952-0 fIfKvi\"><span data-testid=\"card-metadata-lastupdated\" class=\"IndexCardMetadata-styles__MetaDataDateStyled-sc-10966952-1 feNzEJ\">21 hrs ago</span><div data-testid=\"card-metadata-separator\" class=\"IndexCardMetadata-styles__Separator-sc-10966952-3 decXPj\"></div><span data-testid=\"card-metadata-tag\" class=\"IndexCardMetadata-styles__MetaDataTagStyled-sc-10966952-2 ewmvhB\">Health</span></div></div></div></a></div></div></div></div></section></section><div data-testid=\"ad-unit\" data-component=\"ad-slot\" class=\"AdSlot-styles__AdSlotContainerStyled-sc-4b576bed-0 cIETQw\"><div data-testid=\"dotcom-mid_1\" id=\"dotcom-mid_1\" class=\"dotcom-ad\"