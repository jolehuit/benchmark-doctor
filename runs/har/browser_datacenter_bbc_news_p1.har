66952-0 fIfKvi\"><span data-testid=\"card-metadata-lastupdated\" class=\"IndexCardMetadata-styles__MetaDataDateStyled-sc-10966952-1 feNzEJ\">19 hrs ago</span><div data-testid=\"card-metadata-separator\" class=\"IndexCardMetadata-styles__Separator-sc-10966952-3 decXPj\"></div><span data-testid=\"card-metadata-tag\" class=\"IndexCardMetadata-styles__MetaDataTagStyled-sc-10966952-2 ewmvhB\">Culture</span></div></div></div></a></div></div></div><div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 igNVuU\"><div data-testid=\"manchester-card\" data-indexcard=\"true\" class=\"IndexCard-styles__IndexCardStyled-sc-3a0d8802-0 jeApUG\"><div data-testid=\"anchor-inner-wrapper\"><a href=\"/news/articles/c5yvrn7rpqpo\" data-testid=\"internal-link\" class=\"Anchor-styles__AnchorStyled-sc-651d33db-0 hygVWX\"><div data-testid=\"manchester-article\" class=\"Manchester-styles__CardStyled-sc-5c1d085b-1 cGPaOi\"><div data-testid=\"card-text-wrapper\" class=\"Manchester-styles__TextWrapperStyled-sc-5c1d085b-2 eshOej\"><div class=\"IndexCardHeading-styles__TitleGravityWrapper-sc-c7d910a6-1 dWFLGi\"><div class=\"IndexCardHeading-styles__TitleWrapperStyled-sc-c7d910a6-0 hEhfIe\"><h2 data-testid=\"card-headline\" class=\"IndexCardHeading-styles__CardHeadlineStyled-sc-c7d910a6-3 dyeGOh\">The influencers getting bitten while chasing the perfect shark shot</h2></div></div><p data-testid=\"card-description\" class=\"Manchester-styles__DescriptionStyled-sc-5c1d085b-0 coxKqG\">Tayane Dalazen was on a shark-diving trip in Brazil when she was attacked.</p><div class=\"IndexCardMetadata-styles__MetadataStyled-sc-10966952-0 fIfKvi\"><span data-testid=\"card-metadata-lastupdated\" class=\"IndexCardMetadata-styles__MetaDataDateStyled-sc-10966952-1 feNzEJ\">22 hrs ago</span><div data-testid=\"card-metadata-separator\" class=\"IndexCardMetadata-styles__Separator-sc-10966952-3 decXPj\"></div><span data-testid=\"card-metadata-tag\" class=\"IndexCardMetadata-styles__MetaDataTagStyled-sc-10966952-2 ewmvhB\">Science &amp; Environment</span></div></div></div></a></div></div></div><div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 dHtWoZ\"><div data-testid=\"manchester-card\" data-indexcard=\"true\" class=\"IndexCard-styles__IndexCardStyled-sc-3a0d8802-0 jeApUG\"><div data-testid=\"anchor-inner-wrapper\"><a href=\"/news/articles/c0rd2e804jko\" data-testid=\"internal-link\" class=\"Anchor-styles__AnchorStyled-sc-651d33db-0 hygVWX\"><div data-testid=\"manchester-article\" class=\"Manchester-styles__CardStyled-sc-5c1d085b-1 cGPaOi\"><div data-testid=\"card-text-wrapper\" class=\"Manchester-styles__TextWrapperStyled-sc-5c1d085b-2 eshOej\"><div class=\"IndexCardHeading-styles__TitleGravityWrapper-sc-c7d910a6-1 dWFLGi\"><div class=\"IndexCardHeading-styles__TitleWrapperStyled-sc-c7d910a6-0 hEhfIe\"><h2 data-testid=\"card-headline\" class=\"IndexCardHeading-styles__CardHeadlineStyled-sc-c7d910a6-3 dyeGOh\">These women are set to scale a 25ft greasy pole to win a prize ham</h2></div></div><p data-testid=\"card-description\" class=\"Manchester-styles__DescriptionStyled-sc-5c1d085b-0 coxKqG\">The five women will try to scale a 25ft wooden pole covered in grease and claim the prize at the top - a ham.</p><div class=\"IndexCardMetadata-styles__MetadataStyled-sc-10966952-0 fIfKvi\"><span data-testid=\"card-metadata-lastupdated\" class=\"IndexCardMetadata-styles__MetaDataDateStyled-sc-10966952-1 feNzEJ\">21 hrs ago</span><div data-testid=\"card-metadata-separator\" class=\"IndexCardMetadata-styles__Separator-sc-10966952-3 decXPj\"></div><span data-testid=\"card-metadata-tag\" class=\"IndexCardMetadata-styles__MetaDataTagStyled-sc-10966952-2 ewmvhB\">Glasgow &amp; West Scotland</span></div></div></div></a></div></div></div></div></div><div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 pTIUX\"><div data-testid=\"dundee-card\" data-indexcard=\"true\" class=\"IndexCard-styles__IndexCardStyled-sc-3a0d8802-0 jeApUG\"><div data-testid=\"anchor-inner-wrapper\"><a href=\"/n