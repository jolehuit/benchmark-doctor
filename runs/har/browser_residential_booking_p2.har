tions-traveller/Reviews@2x.png 2x\" role=\"presentation\" loading=\"lazy\"/></picture><h3 style=\"--bui_mixin_spaced_margin--s:0\" class=\"e7addce19e f76b4e9cbc e19e5a7d46\">Plus de 300 millions de commentaires</h3><p style=\"--bui_mixin_spaced_margin-block-start--s:2\" class=\"b99b6ef58f f76b4e9cbc dceb352308\">Obtenez des informations de clients comme vous.</p></div><div data-testid=\"usp-expanded-design\" style=\"--bui_box_spaced_padding--s:4\" class=\"c3bdfd4ac2 aeab2b121e\"><picture class=\"b7a691c583 cc39684d69\" style=\"--bui_image_width--s:64px;--bui_image_height--s:64px;--bui_mixin_spaced_margin-block-end--s:4\"><img class=\"f6c12c77eb db4ad1b412 c09abd8a52 ca3dad4476\" src=\"https://t-cf.bstatic.com/design-assets/assets/v3.198.0/illustrations-traveller/TripsGlobe.png\" srcSet=\"https://t-cf.bstatic.com/design-assets/assets/v3.198.0/illustrations-traveller/TripsGlobe@2x.png 2x\" role=\"presentation\" loading=\"lazy\"/></picture><h3 style=\"--bui_mixin_spaced_margin--s:0\" class=\"e7addce19e f76b4e9cbc e19e5a7d46\">Plus de 2 millions d&#x27;établissements à travers le monde</h3><p style=\"--bui_mixin_spaced_margin-block-start--s:2\" class=\"b99b6ef58f f76b4e9cbc dceb352308\">Hôtels, maisons d&#x27;hôtes, appartements, etc.</p></div><div data-testid=\"usp-expanded-design\" style=\"--bui_box_spaced_padding--s:4\" class=\"c3bdfd4ac2 aeab2b121e\"><picture class=\"b7a691c583 cc39684d69\" style=\"--bui_image_width--s:64px;--bui_image_height--s:64px;--bui_mixin_spaced_margin-block-end--s:4\"><img class=\"f6c12c77eb db4ad1b412 c09abd8a52 ca3dad4476\" src=\"https://t-cf.bstatic.com/design-assets/assets/v3.198.0/illustrations-traveller/CustomerSupport.png\" srcSet=\"https://t-cf.bstatic.com/design-assets/assets/v3.198.0/illustrations-traveller/CustomerSupport@2x.png 2x\" role=\"presentation\" loading=\"lazy\"/></picture><h3 style=\"--bui_mixin_spaced_margin--s:0\" class=\"e7addce19e f76b4e9cbc e19e5a7d46\">Un Service Clients de confiance, disponible 24h/24 et 7j/7</h3><p style=\"--bui_mixin_spaced_margin-block-start--s:2\" class=\"b99b6ef58f f76b4e9cbc dceb352308\">Nous sommes là pour vous aider, à tout moment</p></div></div></div></div></div></div></div></div></div><div class=\"shell__stack-item\"><div class=\"shell__region-wrapper\" data-testid=\"tracking-wrapper\"><div><div style=\"--bui_stack_spaced_gap--s:4;--bui_stack_spaced_gap--m:8\" class=\"f6e3a11b0d ae5dbab14d e95943ce9b shell__stack\"><div class=\"shell__stack-item\"><div><div id=\"RecentSearchesCarousel\" style=\"--bui_box_spaced_padding--s:0\" class=\"c3bdfd4ac2 shell__cp-wrapper\"></div></div></div><div class=\"shell__stack-item\"><div><div id=\"RecentlyViewedCarouselDesktop\" style=\"--bui_box_spaced_padding--s:0\" class=\"c3bdfd4ac2 shell__cp-wrapper\"></div></div></div></div></div></div></div><div class=\"shell__stack-item\"><div class=\"shell__region-wrapper\" data-testid=\"tracking-wrapper\"><div><div style=\"--bui_stack_spaced_gap--s:4;--bui_stack_spaced_gap--m:8\" class=\"f6e3a11b0d ae5dbab14d e95943ce9b shell__stack\"><div class=\"shell__stack-item\"><div><div id=\"SecondaryBannerDesktop\" style=\"--bui_box_spaced_padding--s:0\" class=\"c3bdfd4ac2 shell__cp-wrapper\"><div><div class=\"ecb8d66605 c16b6d7ba2 daadf70613\"><h2 class=\"a4ac75716e f546354b44 cc045b173b\">Offres</h2><div class=\"da8a6fe12c fb14de7f14 fdf31a9fa1\">Des promotions, des réductions et des offres spécialement pour vous</div></div><div class=\"b90d2af1bb\" data-testid=\"secondary-banner-banners-single-test-id\"><div><div><div data-testid=\"promotional-banner-container\" style=\"--bui_box_spaced_padding--s:4\" class=\"c3bdfd4ac2 a0ab5da06c d46ff48a92 f728e61e72 d0acd69e66 c256f1a28a d726fb55bc aabe312a16 bc1c39249c\"><div style=\"--bui_stack_spaced_gap--s:0\" class=\"f6e3a11b0d a19a26a18c a81870d302 ac30880487 e95943ce9b\"><div class=\"aa225776f2 ca9d921c46\"><div style=\"--bui_stack_spaced_gap--s:1\" class=\"f6e3a11b0d ae5dbab14d d8df6227ee ff07c65a27 e95943ce9b\"><div data-testid=\"pro